# SnowLuma is obtained separately; publish documentation only
/snowluma/*
!/snowluma/README.md
_snowluma-catalog.json

# Publish portable operations files, never machine-specific service definitions
/ops/*
!/ops/README.md
!/ops/status.mjs
!/ops/maintenance.py
!/ops/systemd/
/ops/systemd/*
!/ops/systemd/*.example

# User-authored/current bot persona files stay local
/qq-bridge/roles/*
!/qq-bridge/roles/README.md
!/qq-bridge/roles/*.example.md

# Editor and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
