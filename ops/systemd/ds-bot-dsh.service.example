# AI-assisted example. Adapt paths before installing; not a production snapshot.
[Unit]
Description=DeepSeek Harness for QQ bot
PartOf=ds-bot.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Project/DS_bot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DSH_HOME=%h/.dsh"
Environment="LANG=C.UTF-8"
ExecStart=%h/.local/bin/node %h/.local/bin/dsh web
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
